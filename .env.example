# === LLM API ===
# External FHIR sandbox; use synthetic data only.
FHIR_BASE_URL=http://hapi.fhir.org/baseR4
# One JSON object: backend name -> upstream base URL. LibreChat lists every backend
# through one endpoint, http://llm-provost:8000/llm/v1, with ids prefixed by the name
# (ollama/..., bedrock/...). Per-backend clients can call /llm/<name>/v1/...
# Replace vllm-host with your vLLM server (OpenAI-compatible, `vllm serve`).
LLM_ROUTES_JSON={"openwire":"http://host.docker.internal:3030/v1","ollama":"http://xps:11434/v1","vllm":"http://vllm-host:8000/v1","bedrock":"https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1"}
# The aggregate endpoint /llm/v1 serves every backend above from one base URL:
# model ids are prefixed with the backend name (ollama/gpt-oss:20b,
# bedrock/openai.gpt-oss-20b-1:0). "v1" is reserved and cannot be a backend name.
# LibreChat's "Provost" endpoint uses this URL; BEDROCK_MODEL below is its default model.
# How long a failed backend is skipped before re-probe; lower = faster
# recovery, more log lines on flapping backends. Read once at startup.
PROVOST_BACKEND_COOLDOWN_SECONDS=180
LLM_API_KEY=your-llm-api-key
OLLAMA_API_KEY=ollama

# === Amazon Bedrock ===
# Requests are SigV4-signed by the proxy. Credentials come from AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN) in the proxy environment, otherwise from
# the shared credentials file mounted from ~/.aws (override with AWS_SHARED_CREDENTIALS_DIR,
# select a profile with AWS_PROFILE). Set BEDROCK_ENABLED=false to disable the backend.
BEDROCK_ENABLED=true
BEDROCK_AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL=openai.gpt-oss-20b-1:0
# How inline <reasoning>...</reasoning> tags (Bedrock gpt-oss) are shown to clients:
# off (default, responses untouched), openai (move reasoning into reasoning_content),
# or think (rename the tags to <think>). Audit logs always keep the original tags.
# Read once at startup: restart the proxy container after changing it.
REASONING_DISPLAY=off

# === AWS / Fluent Bit audit logging ===
# S3 is the primary audit sink: access records go to
# s3://$S3_BUCKET/${S3_KEY_PREFIX}llm-provost/logs/access/YYYY/MM/DD/HH/ and
# error/intervention records to .../logs/error/YYYY/MM/DD/HH/. A local copy is
# always written to logs/fluent-bit-storage/{access,error}.log.
S3_BUCKET=your-s3-bucket-name
# Optional key prefix; include a trailing slash (e.g. prod/). Empty = bucket root.
S3_KEY_PREFIX=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# Only for temporary (STS) credentials.
AWS_SESSION_TOKEN=
# Reported in each record's Instance_ID when not on EC2 (IMDS supplies it there).
INSTANCE_ID=local-dev
# true = also print every audit record shipped to S3 on fluent-bit's stdout
# (docker compose logs fluent-bit), same JSON line as S3. Default false: no
# audit records in docker logs. Read at start: recreate fluent-bit to change it.
PROVOST_LOG_DEBUG=false

# === Cognito OIDC (Production) ===
OPENID_CLIENT_ID=your-cognito-client-id
OPENID_CLIENT_SECRET=your-cognito-client-secret
OPENID_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_SESSION_SECRET=change-this-to-a-random-string
OPENID_SCOPE=openid profile email phone
OPENID_AUTO_REDIRECT=true
OPENID_BUTTON_LABEL=Continue with Cognito
OPENID_NAME_CLAIM=given_name

# LibreChat proxy/login tuning for local Cognito development.
TRUST_PROXY=1
LOGIN_MAX=50
LOGIN_WINDOW=1

# === LibreChat / OpenAI ===
OPENAI_API_KEY=your-openai-api-key

# === Meilisearch ===
MEILI_MASTER_KEY=provost-dev-meili-key
