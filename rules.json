{
  "tool_allowlist": {
    "enabled": true,
    "description": "Allow only approved MCP tools.",
    "params": {
      "tools": [
        "get_records",
        "list_items",
        "summarize_report",
        "export_summary"
      ]
    }
  },
  "tool_blocklist": {
    "enabled": true,
    "description": "Block destructive or bulk-export operations.",
    "params": {
      "tools": [
        "delete_record",
        "export_full_database"
      ]
    }
  },
  "rate_limits": {
    "enabled": true,
    "description": "Apply per-tool rate limits.",
    "params": {
      "rules": {
        "get_records": {
          "max_calls": 10,
          "window_seconds": 60
        },
        "summarize_report": {
          "max_calls": 20,
          "window_seconds": 300
        }
      }
    }
  },
  "token_caps": {
    "enabled": true,
    "description": "Limit token-heavy requests.",
    "params": {
      "max_tokens": 4096,
      "max_prompt_tokens": 8192
    }
  },
  "time_based_rules": {
    "enabled": true,
    "description": "Restrict selected tools to approved business hours.",
    "params": {
      "rules": [
        {
          "tool": "export_summary",
          "allowed_hours": "09:00-17:00",
          "timezone": "America/New_York"
        }
      ]
    }
  },
  "logging_rules": {
    "enabled": true,
    "description": "Require identity-rich audit logging.",
    "params": {
      "always_log_user_id": true,
      "always_log_customer_id": true,
      "always_log_tool_name": true,
      "redact_prompt_content": false
    }
  },
  "llm_rules": {
    "enabled": true,
    "description": "Governance for LLM chat requests (non-MCP paths): PII filtering on prompts and token caps.",
    "params": {
      "max_tokens": 4096,
      "pii_block": [
        "us_ssn",
        "aws_access_key",
        "private_key_block",
        "github_token"
      ],
      "pii_patterns": {}
    }
  },
  "mcp_servers": {
    "alpaca": {
      "tool_allowlist": {
        "enabled": false,
        "description": "Optional per-server allowlist. Disabled: Alpaca tools are governed by the trading rules below, matching Agent Provost behavior.",
        "params": {
          "tools": []
        }
      },
      "share_limits": {
        "enabled": true,
        "description": "Block trades whose share quantity exceeds the configured limit (Agent Provost max_trade_size).",
        "params": {
          "limit": 100
        }
      },
      "max_notional": {
        "enabled": true,
        "description": "Block trades whose dollar notional value exceeds the configured limit (Agent Provost max_trade_notional).",
        "params": {
          "limit": 50000
        }
      },
      "cumulative_trade_notional": {
        "enabled": true,
        "description": "Block cumulative dollar exposure across multiple orders within a short rolling window.",
        "params": {
          "limit": 50000,
          "window_seconds": 300
        }
      },
      "symbol_order_cooldown": {
        "enabled": true,
        "description": "Block repeat orders for the same symbol within a rolling time window.",
        "params": {
          "window_seconds": 300
        }
      },
      "symbol_blocklist": {
        "enabled": true,
        "description": "Block trades on tickers in the restricted symbol list (Agent Provost blocked_tickers).",
        "params": {
          "tickers": ["GME", "AMC", "BBBY"]
        }
      },
      "symbol_allowlist": {
        "enabled": false,
        "description": "Draconian Mode: block ALL trades except symbols in this allowlist (Agent Provost allowed_tickers).",
        "params": {
          "tickers": ["SPY", "QQQ"]
        }
      },
      "allowed_asset_classes": {
        "enabled": true,
        "description": "Allow trading only for listed asset classes.",
        "params": {
          "classes": ["us_equity", "crypto", "us_option"]
        }
      },
      "restricted_ticker_tool_rules": {
        "enabled": true,
        "description": "Block restricted ticker symbols when used by specific trade tools, regardless of argument field naming.",
        "params": {
          "tools": ["place_stock_order", "place_option_order", "place_crypto_order"],
          "tickers": ["GME", "AMC", "BBBY"]
        }
      },
      "forbidden_endpoints": {
        "enabled": true,
        "description": "Hard-block method+path endpoint templates on the outbound MCP-to-API hop (Agent Provost forbidden_tools).",
        "params": {
          "tools": [
            "DELETE /v2/positions",
            "DELETE /v2/orders",
            "DELETE /v1/trading/accounts/{account_id}/orders",
            "DELETE /v1/trading/accounts/{account_id}/positions",
            "POST /v1/transfers",
            "POST /v1/journals",
            "POST /v1/journals/batch",
            "POST /v1/journals/reverse_batch",
            "POST /v1/funding_wallets/withdrawals",
            "POST /v1/crypto/wallets/withdrawals",
            "POST /v1/crypto/wallets/whitelisted_addresses",
            "POST /v1/instant_funding",
            "POST /v1/trading/accounts/{account_id}/options/exercise",
            "PATCH /v2/account/configurations",
            "PATCH /v1/trading/accounts/{account_id}/account/configurations",
            "POST /v1/rebalancing/runs",
            "POST /v1/rebalancing/portfolios",
            "PATCH /v1/rebalancing/portfolios/{portfolio_id}",
            "POST /v1/rebalancing/subscriptions",
            "POST /v1/crypto/perps/wallets/withdrawals",
            "POST /v1/crypto/perps/wallets/whitelisted_addresses",
            "POST /v1/crypto/perps/leverage"
          ]
        }
      },
      "max_replace_notional": {
        "enabled": true,
        "description": "Block order replacement requests when replacement notional exceeds policy limit.",
        "params": {
          "limit": 10000
        }
      },
      "prevent_market_order_upgrade": {
        "enabled": true,
        "description": "Block replacing limit orders with market orders.",
        "params": {
          "enabled": true
        }
      },
      "max_close_notional": {
        "enabled": true,
        "description": "Block close-position requests above configured notional limit.",
        "params": {
          "limit": 10000
        }
      },
      "allowed_close_tickers": {
        "enabled": true,
        "description": "Allow close-position requests only for configured symbols.",
        "params": {
          "tickers": ["AAPL", "MSFT", "ETH/USD"]
        }
      },
      "trading_window": {
        "enabled": false,
        "description": "Restrict automated trading to allowed UTC hours only.",
        "params": {
          "start_hour": 13,
          "end_hour": 21
        }
      }
    }
  }
}
